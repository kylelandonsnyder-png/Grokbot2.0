# Copy to `.env` in the repo root. Never commit `.env`.
# The app is fully usable with every value left blank (local demo + mock valuations).

# ---------------------------------------------------------------------------
# Auth (Supabase) — do this first when you want real accounts
# Project Settings → API → Project URL + anon public key.
# Never put the service_role key in the Expo app or this file.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public web origin for OAuth redirects (EAS Hosting / Vercel). Optional for email/password.
EXPO_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Local helper (valuations now; Plaid later)
# ---------------------------------------------------------------------------
# Leave EMPTY so valuations use the on-device mock and Plaid stays off.
# EXPO_PUBLIC_HELPER_URL=http://localhost:8787
# EXPO_PUBLIC_PLAID_SERVER_URL=http://localhost:8787   # alias; either works
# Physical phone: http://192.168.1.20:8787
# Android emulator: http://10.0.2.2:8787
EXPO_PUBLIC_HELPER_URL=
EXPO_PUBLIC_PLAID_SERVER_URL=

# ---------------------------------------------------------------------------
# Helper server only (`npm run server`)
# ---------------------------------------------------------------------------
RENTCAST_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
# Allowed: sandbox (default) | production. Plaid is later — leave blank.
PLAID_ENV=sandbox
PORT=8787
