# Copy this file to `.env` in the repo root. Never commit `.env`.
# The Expo app is fully usable with every value left blank (on-device fixtures).

# ---------------------------------------------------------------------------
# Expo client (baked in at `npx expo start` / EAS Build time)
# ---------------------------------------------------------------------------
# Helper base URL for Plaid Link + snapshot import.
# Leave EMPTY to stay in demo/fixture mode (recommended until you have sandbox keys).
# Examples when you are ready:
#   EXPO_PUBLIC_PLAID_SERVER_URL=http://localhost:8787
#   EXPO_PUBLIC_PLAID_SERVER_URL=http://192.168.1.20:8787   # physical phone on LAN
#   EXPO_PUBLIC_PLAID_SERVER_URL=http://10.0.2.2:8787       # Android emulator
EXPO_PUBLIC_PLAID_SERVER_URL=

# ---------------------------------------------------------------------------
# Helper server only (`npm run server` / server/index.js)
# Never put these in the Expo app, EAS public env, or app.json.
# Access tokens are written only to server/data/items.json (gitignored).
# ---------------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# Allowed: sandbox (default) | production
# Anything else falls back to sandbox. Start here; flip only after Plaid prod approval.
PLAID_ENV=sandbox
PORT=8787
