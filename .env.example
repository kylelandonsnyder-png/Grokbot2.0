# Copy to .env (never commit .env). The app is fully usable without these.

# Optional local helper for Plaid Link token exchange.
# Access tokens stay on this server only — never in the Expo client.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PORT=8787

# Expo client. Point at the helper when you want live sandbox Link.
# Leave unset to run 100% on-device mock/fixture data.
EXPO_PUBLIC_PLAID_SERVER_URL=http://localhost:8787
